{
  "display_information": {
    "name": "Sidekick",
    "description": "A sidekick for everyone on the team — debugs infra, ships fixes and features as PRs.",
    "background_color": "#18181b"
  },
  "features": {
    "bot_user": { "display_name": "sidekick", "always_online": true },
    "app_home": { "home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write", "channels:history", "groups:history", "im:history", "users:read"]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.im"] },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}

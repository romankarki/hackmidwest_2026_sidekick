# Copy to .env and fill in (never commit .env)

# Bot token: api.slack.com/apps → Sidekick → OAuth & Permissions → "Bot User OAuth Token" (after Install to Workspace)
SLACK_BOT_TOKEN=xoxb-...

# App-level token: Basic Information → App-Level Tokens → Generate (scope: connections:write)
SLACK_APP_TOKEN=xapp-...

# Optional — seconds per tool call (min,max)
SIDEKICK_STEP_DELAY=2,3
# Optional — after approval: staging | straight | pr_only (same as the dashboard presets)
SIDEKICK_DELIVERY=staging
# Optional — Slack user IDs allowed to approve, comma-separated (empty = anyone)
SIDEKICK_APPROVERS=
